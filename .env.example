# ─── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Production da aniq domain: https://yourdomain.com
CORS_ORIGIN=*

# ─── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_strong_db_password
DB_NAME=stadium_db

# ─── JWT ─────────────────────────────────────────────────────
# Yaratish: openssl rand -hex 32
JWT_SECRET=replace-with-32-char-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-32-char-random-string
JWT_REFRESH_EXPIRES_IN=7d

# ─── Seed ────────────────────────────────────────────────────
# Birinchi ishga tushirishda superadmin paroli
SUPERADMIN_PASSWORD=your_strong_password
